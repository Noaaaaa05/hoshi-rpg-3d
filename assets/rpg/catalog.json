  "dialogues": {
    "mina-watchpost": {
      "start": "greeting",
      "nodes": {
        "greeting": {
          "text": "北東にある見張り台まで行って、灯りがついているか見てきてくれない？",
          "choices": [
            {
              "label": "見回りを引き受ける",
              "quest": "watchpost-round",
              "action": "offer",
              "next": "accepted"
            },
            {
              "label": "見回りを報告する",
              "quest": "watchpost-round",
              "action": "turn-in",
              "next": "thanks"
            },
            {
              "label": "旅の話をする",
              "quest": "watchpost-round",
              "when": "complete",
              "next": "thanks"
            }
          ]
        },
        "accepted": {
          "text": "ありがとう。小径から北東に進むと、屋根の小屋と明かりが見えるよ。",
          "choices": []
        },
        "thanks": {
          "text": "おつかれさま。短剣と三連撃を旅に役立ててね。よかったら少しのあいだ一緒に行こう。",
          "choices": [
            {
              "label": "ミナを仲間にする",
              "action": "recruit",
              "next": "joined"
            }
          ]
        },
        "joined": {
          "text": "うん、ついていくよ。",
          "choices": []
        }
      }
    }
  },
