{
  "name": "hoshi-rpg-3d",
  "version": "0.2.4",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "test": "node --import ./tests/register-three.mjs --test tests/*.test.mjs",
    "check": "node scripts/check.mjs",
    "test:browser": "playwright test",
    "test:browser:chromium": "playwright test --project=chromium-desktop --project=chromium-touch",
    "meshy:dry-run": "node scripts/meshy/generate.mjs --dry-run",
    "meshy:generate": "node scripts/meshy/generate.mjs --execute",
    "rpg:check": "node --import ./tests/register-three.mjs scripts/rpg/catalog.mjs check",
    "rpg:apply": "node --import ./tests/register-three.mjs scripts/rpg/catalog.mjs apply",
    "rpg:release": "node scripts/rpg/release.mjs",
    "rpg:asset": "node --import ./tests/register-three.mjs scripts/rpg/asset.mjs",
    "rpg:verify-pages": "node scripts/rpg/verify-pages.mjs",
    "meshy:retrieve": "node scripts/meshy/retrieve-task.mjs",
    "assets:extract": "python3 tools/asset_pipeline/pipeline.py",
    "assets:test": "python3 -m unittest discover -s tests/assets -p \"test_*.py\"",
    "assets:plan": "node scripts/assets/plan.mjs",
    "assets:register": "node --import ./tests/register-three.mjs scripts/assets/register.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1"
  }
}
